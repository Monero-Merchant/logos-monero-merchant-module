{
  "name": "monero_merchant_ui",
  "display_name": "Monero Merchant",
  "version": "0.1.0",
  "type": "ui_qml",
  "interface": "universal",
  "category": "wallet",
  "description": "Wallet connection, POS pairing, Stagenet invoices and payment tracking",
  "main": "monero_merchant_ui_plugin",
  "icon": "src/icons/icon.png",
  "view": "qml/Main.qml",
