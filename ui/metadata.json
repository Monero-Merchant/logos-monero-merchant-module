    "packages": {
      "build": [
        "pkg-config"
      ],
      "runtime": [
        "qrencode"
      ]
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  }
